uint32 command_id
uint8 opcode
int32 argument
builtin_interfaces/Duration ack_timeout
# Execution identity inherited from ExecuteTask, so CAN-side stage evidence can
# be grouped with the task that caused it. Empty when the caller has no trace.
string trace_id
---
uint8 COMPLETED=0
uint8 CANCELED=1
uint8 SAFE_STOP=2
uint8 DEVICE_FAULT=3
uint8 outcome
uint16 error_code
string message
---
uint8 SENDING=1
uint8 WAITING_ACK=2
uint8 RETRYING=3
uint8 STOPPING=4
# The command is on the wire and the device reported it is still moving. Only
# sent for devices whose protocol distinguishes execution from the ACK.
uint8 EXECUTING=5
uint8 state
uint8 retry_count
# The device's own completion state, when it reports one. ACK_ONLY means the
# protocol only acknowledges, so the result means "acknowledged", not "finished".
uint8 COMPLETION_UNKNOWN=0
uint8 COMPLETION_ACK_ONLY=1
uint8 COMPLETION_ACCEPTED=2
uint8 COMPLETION_EXECUTING=3
uint8 COMPLETION_COMPLETED=4
uint8 COMPLETION_FAULTED=5
uint8 completion
